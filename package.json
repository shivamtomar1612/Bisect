{
  "name": "bisect",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm --filter @bisect/web dev",
    "build": "pnpm --filter @bisect/vm run build && pnpm --filter @bisect/web run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "local:anvil": "node scripts/run-anvil.mjs",
    "check:anvil": "node scripts/check-anvil.mjs",
    "contracts:build": "node scripts/run-foundry.mjs build",
    "contracts:test": "node scripts/run-foundry.mjs test",
    "db:up": "node scripts/run-docker.mjs compose up -d --wait --wait-timeout 60 postgres",
    "db:down": "node scripts/run-docker.mjs compose stop postgres",
    "db:health": "node scripts/run-docker.mjs compose exec -T postgres pg_isready -U bisect -d bisect",
    "db:migrate": "pnpm --filter @bisect/indexer db:migrate",
    "db:generate": "pnpm --filter @bisect/indexer db:generate",
    "db:smoke": "pnpm --filter @bisect/indexer db:smoke",
    "db:restart-check": "node scripts/check-db-restart.mjs",
    "check:base-sepolia": "node scripts/check-base-sepolia.mjs",
    "check:environment": "node scripts/check-environment.mjs",
    "check:all": "node scripts/check-all.mjs",
    "bisect": "node scripts/bisect.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
