# Copy to .env for Compose and local application tooling. Replace the password locally.
POSTGRES_USER=bisect
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_DB=bisect
DATABASE_URL=postgresql://bisect:replace-with-a-long-random-local-password@127.0.0.1:5432/bisect?schema=public

# Base Sepolia (public testnet), not local Anvil.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_CHAIN_ID=84532
NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID=84532

# Phase 12 browser wallet configuration. Set the registry only after verifying a deployment.
# Use chain 31337 and local RPC for an isolated Anvil demonstration.
NEXT_PUBLIC_BISECT_CHAIN_ID=84532
NEXT_PUBLIC_BISECT_RPC_URL=https://sepolia.base.org
# NEXT_PUBLIC_BISECT_REGISTRY_ADDRESS=

# Local Anvil only.
ANVIL_RPC_URL=http://127.0.0.1:8545
ANVIL_CHAIN_ID=31337

# Configure these explicitly for one deployed registry before starting the read indexer.
# No contract is currently deployed by this repository.
# INDEXER_RPC_URL=https://sepolia.base.org
# INDEXER_CHAIN_ID=84532
# INDEXER_CONTRACT_ADDRESS=
# INDEXER_DEPLOYMENT_BLOCK=
# INDEXER_CONFIRMATIONS=6
# INDEXER_SCAN_RANGE=500
# INDEXER_MAX_REORG_DEPTH=128
# INDEXER_POLL_INTERVAL_MS=4000
# INDEXER_API_HOST=127.0.0.1
# INDEXER_API_PORT=8787

# Server-only frontend read endpoint. Never prefix this with NEXT_PUBLIC_.
# Set to http://127.0.0.1:8787 after configuring and starting the indexer API.
# BISECT_INDEXER_API_URL=http://127.0.0.1:8787

# No deployment script currently requires a signer or deployed address.
# DEPLOYER_PRIVATE_KEY=
# CONTRACT_ADDRESS=

# Optional Phase 15 challenger. Dry-run is the default. Keep this signer dedicated
# to the bot, testnet-only, and in a secret manager or process environment.
# Never place a real key in this file. Broadcasting requires the explicit opt-in,
# verified registry address, signer, and all three positive wei caps below.
# BISECT_BOT_RPC_URL=http://127.0.0.1:8545
# BISECT_BOT_CHAIN_ID=31337
# BISECT_BOT_REGISTRY_ADDRESS=
# BISECT_BOT_DEPLOYMENT_BLOCK=0
# BISECT_BOT_CONFIRMATIONS=1
# BISECT_BOT_POLL_INTERVAL_MS=3000
# BISECT_BOT_MAX_RETRIES=3
# BISECT_BOT_MAX_TOTAL_SPEND_WEI=0
# BISECT_BOT_MAX_BOND_WEI=0
# BISECT_BOT_MAX_GAS_PER_TX_WEI=0
# BISECT_BOT_STATE_PATH=.bisect/challenger-state.json
# BISECT_BOT_LOG_PATH=.bisect/challenger.jsonl
# BISECT_BOT_BROADCAST=false
# BISECT_BOT_PRIVATE_KEY=
# Local Anvil only; ignored for all public networks.
# BISECT_BOT_USE_UNLOCKED_ACCOUNT=false
# BISECT_BOT_UNLOCKED_ADDRESS=
